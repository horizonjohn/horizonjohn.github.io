<div class="news">
  {% if site.news != blank %}
    {% assign news_size = site.news | size %}
    {% assign visible_news_count = site.announcements.limit | default: 4 %}
    {% assign news_scrollable = false %}
    {% if include.limit and site.announcements.scrollable and news_size > visible_news_count %}
      {% assign news_scrollable = true %}
    {% endif %}
    <div class="news-scroll-frame">
      <div
        class="table-responsive{% if news_scrollable %} news-scrollable{% endif %}"
        {% if news_scrollable %}
          data-visible-news-count="{{ visible_news_count }}"
          aria-label="Scrollable news list"
          tabindex="0"
        {% endif %}
      >
        <table class="table table-sm table-borderless">
          {% assign news = site.news | sort: 'month' | reverse %}
          {% if news_scrollable %}
            {% assign news_limit = news_size %}
          {% elsif include.limit and site.announcements.limit %}
            {% assign news_limit = site.announcements.limit %}
          {% else %}
            {% assign news_limit = news_size %}
          {% endif %}
          {% for item in news limit: news_limit %}
            <tr>
              <th scope="row" style="width: 10%">
                {% if item.month %}
                  {{ item.month | append: '-01' | date: '%b %Y' }}
                {% else %}
                  {{ item.date | date: '%b %Y' }}
                {% endif %}
              </th>
              <td>
                {% if item.inline %}
                  {{ item.content | remove: '<p>' | remove: '</p>' | emojify }}
                {% else %}
                  <a class="news-title" href="{{ item.url | relative_url }}">{{ item.title }}</a>
                {% endif %}
              </td>
            </tr>
          {% endfor %}
        </table>
      </div>
      {% if news_scrollable %}
        <div class="news-scrollbar" aria-hidden="true"><span class="news-scrollbar-thumb"></span></div>
      {% endif %}
    </div>
    {% if news_scrollable %}
      <script>
        (() => {
          const frame = document.currentScript.previousElementSibling;
          const container = frame.querySelector('.news-scrollable');
          const table = container.querySelector('table');
          const track = frame.querySelector('.news-scrollbar');
          const thumb = frame.querySelector('.news-scrollbar-thumb');
          const visibleCount = Number(container.dataset.visibleNewsCount);

          const updateScrollbar = () => {
            const trackHeight = track.clientHeight;
            const thumbHeight = Math.max(24, trackHeight * (container.clientHeight / container.scrollHeight));
            const maxScroll = container.scrollHeight - container.clientHeight;
            const maxOffset = trackHeight - thumbHeight;
            const offset = maxScroll > 0 ? (container.scrollTop / maxScroll) * maxOffset : 0;

            thumb.style.height = `${thumbHeight}px`;
            thumb.style.transform = `translateY(${offset}px)`;
          };

          const updateNewsHeight = () => {
            const rows = Array.from(table.querySelectorAll('tr')).slice(0, visibleCount);
            const height = rows.reduce((total, row) => total + row.getBoundingClientRect().height, 0);
            container.style.maxHeight = `${Math.ceil(height)}px`;
            requestAnimationFrame(updateScrollbar);
          };

          updateNewsHeight();
          container.addEventListener('scroll', updateScrollbar, { passive: true });
          new ResizeObserver(updateNewsHeight).observe(table);
        })();
      </script>
    {% endif %}
  {% else %}
    <p>No news so far...</p>
  {% endif %}
</div>
